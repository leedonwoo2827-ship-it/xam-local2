# /exam/ — 문제풀이 앱
#
# ⚠ Apache + AllowOverride 전제. 카페24 웹호스팅은 Apache 다.
#   nginx 로 바뀌면 전부 무효가 되므로 서버 설정으로 옮겨야 한다.

# ── gzip ────────────────────────────────────────────────────────────────
# 50문제 JSON 이 약 65KB → 15KB. 트래픽 한도가 월 4,000MB 라 이게 실질적이다.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE text/html text/css text/plain
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── 캐시 ────────────────────────────────────────────────────────────────
# API 응답은 _boot.php 가 Cache-Control 을 직접 세팅한다(여기서 건드리지 않는다).
# 정적 자산만 다룬다.
<IfModule mod_expires.c>
    ExpiresActive On
    # ★ 7일 → 1시간 (2026-08-04).
    #
    #   문항 그림을 **같은 이름으로** 고쳐 올리면 이미 본 사람에게 최대 7일간 옛 그림이
    #   보였다. 서버에는 새 파일이 있으니 "안 올라갔나?" 하고 다시 올려도 안 바뀐다 —
    #   원인이 캐시라는 걸 알아채기 어렵다.
    #   그림 전체가 245개 199KB 라 1시간 캐시로도 비용이 사실상 없다.
    #   problems.js·theory_content.js 도 같은 1시간이라 배포 후 체감이 한 곳으로 모인다.
    ExpiresByType image/svg+xml            "access plus 1 hour"
    ExpiresByType image/png                "access plus 1 hour"
    ExpiresByType image/jpeg               "access plus 1 hour"
    ExpiresByType image/webp               "access plus 1 hour"
    ExpiresByType text/css                 "access plus 7 days"
    ExpiresByType application/javascript   "access plus 1 hour"
    ExpiresByType text/javascript          "access plus 1 hour"
</IfModule>

# problems.js / theory_content.js 는 빌드마다 바뀐다.
# 1시간 캐시라 배포 직후 최대 1시간 동안 옛 파일이 보일 수 있다 —
# 급하면 파일명에 ?ver= 를 붙이거나 브라우저 강력 새로고침으로 넘긴다.

# ── 노출 차단 ───────────────────────────────────────────────────────────
# sql/ 은 자체 .htaccess 로 막는다. 여기서는 실수로 올라올 수 있는 것들.
<FilesMatch "\.(json|sql|md|py|log|bak|orig|zip|tar|gz|tgz|7z|rar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ⚠ 위 규칙이 problems.json 을 막는다 — 임포트용 파일이 실수로 웹루트에 남아도
#   내려받을 수 없다. (원래 adm/exam_import.php 화면으로만 올린다.)

# ★ 압축 파일도 막는다 (2026-08-21). adm/exam_deploy.php 가 정적 파일 반입용 ZIP 을
#   받기 시작했다. 그 화면은 업로드된 임시 파일을 처리 직후 지우지만, 사람이 ZIP 을
#   FTP 로 여기 올려두는 일은 언제든 생긴다. 그 안에는 문항 전체가 들어 있다.
#   막는 비용이 0 이므로 먼저 막는다.

# api/lib/ 은 include 전용이다. 직접 열 이유가 없다.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^api/lib/ - [F,L]
    RewriteRule ^api/_boot\.php$ - [F,L]
</IfModule>
