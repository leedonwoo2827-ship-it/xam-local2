# XAM LOCAL v2 설정 — 이 파일을 .env 로 복사해서 쓴다.
# 메모장으로 저장해도 되도록 app.py 가 utf-8-sig 로 읽는다(BOM 허용).
#
# v2 는 이 폴더 하나로 돈다. 렌더 엔진(vendor/chodangi)·강의덱 변환기
# (vendor/exam2deck)·발행 빌더와 슬라이드 색(axexam/)이 모두 저장소 안에 있어서
# 외부 코드 폴더를 가리키는 키가 없다. 남는 것은 "작업할 책 폴더" 뿐이다.

# ── 책(작업 폴더) ────────────────────────────────────────────────────────────
# 00/ 01/ 02/ 03/ 04/ 05/ 06/ _rounds/ 를 갖는 산출물 트리.
# 첫 실행 기본값일 뿐이고, 그 뒤로는 작업 폴더 화면에서 고른 폴더(data/books.json)를 쓴다.
XAM_BOOK=D:\00work\ocr-output-260723

# 도구 #1 판독 작업 폴더 (스캔 PNG · 초안 JSON). 비워 두면 책 이름에서 유도한다.
XAM_OCR=

# ── 품목 ────────────────────────────────────────────────────────────────────
# ★ 품목(pd)은 폴더의 _book.json 에서 읽는다. 아래는 표시용 폴백이다.
XAM_PD=bigdata
XAM_PD_LABEL=빅데이터분석기사 필기

# ── 로컬 ────────────────────────────────────────────────────────────────────
# 8871 = v2. 구버전(8870)과 동시에 띄울 수 있다. run.bat/lan.bat 은 PORT 로 덮어쓴다.
XAM_PORT=8871
XAM_JOB_HISTORY=200
XAM_LOG_TAIL=400

# ── 선택 ────────────────────────────────────────────────────────────────────
# 웹 저장소를 다른 클론으로 바꿔 볼 때만. 비우면 이 저장소의 axexam/ 를 쓴다.
# XAM_AXEXAM=
# claude CLI 를 PATH 에서 못 찾을 때만.
# CLAUDE_CLI=
